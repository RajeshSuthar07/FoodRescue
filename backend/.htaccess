RewriteEngine On

# If an Authorization header is sent, make sure PHP/CGI can see it
# (InfinityFree runs PHP as CGI, which normally strips this header).
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Route every request under /api/ to index.php, which contains the router.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# Never allow direct access to config/PHP internals in case rewrite is
# bypassed by a direct file request.
<FilesMatch "\.(sql|env)$">
    Require all denied
</FilesMatch>
