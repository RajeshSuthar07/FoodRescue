# Copy this file to .env for local development, and create a separate
# .env.production for the production build (see README for details).

# Backend API base URL.
# Local (XAMPP):      http://localhost/foodrescue/backend
# Production:         https://YOUR-INFINITYFREE-DOMAIN/api
VITE_API_BASE_URL=https://foodrescue.free.nf/api

# Optional: point these at your own self-hosted OSRM / Nominatim instances
# for production use. If left unset, the app uses the public demo servers,
# which are fine for development/testing but are rate-limited and not
# meant for production traffic (see README section 4).
# VITE_OSRM_SERVICE_URL=https://your-osrm-server.example.com/route/v1
# VITE_NOMINATIM_URL=https://your-nominatim-server.example.com
